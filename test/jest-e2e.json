{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "maxWorkers": 1,
  "testEnvironment": "node",
  "testRegex": "test/.*\\.(e2e-spec|repository\\.spec)\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/application/use-cases/**/*.ts",
    "!src/application/use-cases/users/**"
  ],
  "coverageDirectory": "coverage-e2e"
}
